{
  "name": "prompt-to-pcb-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5174 --strictPort --configLoader native",
    "dev:api": "tsx server/index.ts",
    "build": "vite build --configLoader native",
    "build:server": "tsc -p tsconfig.server.json && node scripts/stage-server-assets.mjs",
    "knowledge": "node scripts/build-component-docs.mjs",
    "knowledge:check": "node scripts/build-component-docs.mjs --check",
    "mcp": "tsx mcp/server.ts",
    "mcp:live-check": "node scripts/mcp-live-check.mjs",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "sandbox": "node sandbox/cli.mjs",
    "sandbox:eval": "node sandbox/eval.mjs",
    "test": "vitest run --configLoader runner",
    "deploy:festo": "vite build --configLoader native --mode festo && firebase deploy --only hosting --config firebase.dev.json --project festo-ai-ed851"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.11.1",
    "animejs": "^4.5.0",
    "avr8js": "0.21.0",
    "jose": "^6.2.6",
    "nodemailer": "^7.0.13",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.3.2",
    "three": "^0.185.1",
    "vite": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}

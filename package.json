{
  "name": "prompt-to-pcb-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort --configLoader native",
    "dev:api": "tsx server/index.ts",
    "build": "vite build --configLoader native",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').cpSync('src/core','dist/server/src/core',{recursive:true})\"",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.11.1",
    "animejs": "^4.5.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}

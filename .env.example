# Server
PORT=8787
HOST=127.0.0.1
# Comma-separated CORS allowlist of frontend origins allowed to call the API.
CORS_ORIGIN=http://127.0.0.1:5174
# Canonical frontend URL used to build links in emails (verification) and Stripe
# return URLs. MUST match the live site, e.g. https://impedo.ai in production —
# if this points at a dead/old domain the verification email link 404s.
# Falls back to CORS_ORIGIN's first entry, then http://127.0.0.1:5174.
APP_URL=http://127.0.0.1:5174
# Optional: max request body size in bytes (default 4MB).
MAX_BODY_BYTES=

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# ── Database (Neon / Postgres) ──
# Leave DATABASE_URL unset for local dev to fall back to a single in-memory
# local admin account (LOCAL_ADMIN_EMAIL/LOCAL_ADMIN_PASSWORD below).
DATABASE_URL=
# Optional: verify TLS against a custom CA, or (local dev only) skip verification.
PG_CA_CERT=
PG_SSL_NO_VERIFY=0
# Optional: only used when DATABASE_URL is unset.
LOCAL_ADMIN_EMAIL=admin@local.test
LOCAL_ADMIN_PASSWORD=PcbPilotLocal!2026

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PCB Pilot

# Frontend
VITE_API_URL=

# ── Sandbox AI provider (Anthropic-compatible endpoint; GLM 5.2 via Z.ai) ──
# The circuit agent (sandbox/) reads credentials from the file named by
# SANDBOX_ENV_FILE (repo-root relative). Absent that file it falls through to
# the process environment, which is how production supplies these.
SANDBOX_ENV_FILE=.env.glm
# Contents of .env.glm (or set directly in the production service environment):
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=glm-5.2
# ANTHROPIC_SMALL_FAST_MODEL=glm-5.2

# Per-user DAILY token allowance. Metered as fresh input + cache writes +
# output; cache reads are free to the meter (they are 85-95% of a run's volume
# at ~1/5 the input price). Resets 00:00 UTC. Default 100000; a sandbox
# implement run bills roughly 20-120k, so 300000 is about 4-8 boards/day.
DAILY_TOKEN_LIMIT=

# ── Hosted MCP connector (see docs/MCP_DEPLOYMENT.md) ──
# Off unless MCP_HTTP_ENABLED=1. In production the OAuth vars are required or
# the endpoint disables itself rather than serving unauthenticated.
MCP_HTTP_ENABLED=
MCP_RESOURCE_URI=
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URI=
MCP_REQUIRED_SCOPE=
# Frontend build-time: the URL the #connect page shows (falls back to VITE_API_URL).
VITE_MCP_BASE_URL=

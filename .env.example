# ── AI provider ──
# Set AI_PROVIDER=ollama for local dev, or an OpenAI-compatible provider
# (groq, openrouter, together, openai, zai/zhipu/bigmodel, or any custom
# OpenAI-compatible endpoint via AI_API_URL) for production.
AI_PROVIDER=groq
AI_API_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
# Optional: only used for zai/zhipu/bigmodel providers.
AI_MAX_TOKENS=
ZAI_THINKING_TYPE=disabled
ZAI_REASONING_EFFORT=none
# Optional: set to "text" to disable the JSON response-format request.
AI_RESPONSE_FORMAT=

# ── Local Ollama (used when AI_PROVIDER=ollama) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_API_KEY=
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2400
OLLAMA_CONTEXT_DIAGNOSTICS=0

# ── Server ──
PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:5173
# Optional: max request body size in bytes (default 4MB).
MAX_BODY_BYTES=

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string

# ── Database (Neon / Postgres) ──
# Leave DATABASE_URL unset for local dev to fall back to a single in-memory
# local admin account (LOCAL_ADMIN_EMAIL/LOCAL_ADMIN_PASSWORD below).
DATABASE_URL=
# Optional: verify TLS against a custom CA, or (local dev only) skip verification.
PG_CA_CERT=
PG_SSL_NO_VERIFY=0
# Optional: only used when DATABASE_URL is unset.
LOCAL_ADMIN_EMAIL=admin@local.test
LOCAL_ADMIN_PASSWORD=PcbPilotLocal!2026

# ── Email (Brevo) ──
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PCB Pilot

# ── Frontend ──
VITE_API_URL=

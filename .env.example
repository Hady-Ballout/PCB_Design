# Server
PORT=8787
HOST=127.0.0.1
# Comma-separated CORS allowlist of frontend origins allowed to call the API.
CORS_ORIGIN=http://127.0.0.1:5174
# Canonical frontend URL used to build links in emails (verification) and Stripe
# return URLs. MUST match the live site, e.g. https://impedo.ai in production —
# if this points at a dead/old domain the verification email link 404s.
# Falls back to CORS_ORIGIN's first entry, then http://127.0.0.1:5174.
APP_URL=http://127.0.0.1:5174
# Optional: max request body size in bytes (default 4MB).
MAX_BODY_BYTES=

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# ── Database (Neon / Postgres) ──
# Leave DATABASE_URL unset for local dev to fall back to a single in-memory
# local admin account (LOCAL_ADMIN_EMAIL/LOCAL_ADMIN_PASSWORD below).
DATABASE_URL=
# Optional: verify TLS against a custom CA, or (local dev only) skip verification.
PG_CA_CERT=
PG_SSL_NO_VERIFY=0
# Optional: only used when DATABASE_URL is unset.
LOCAL_ADMIN_EMAIL=admin@local.test
LOCAL_ADMIN_PASSWORD=PcbPilotLocal!2026

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PCB Pilot

# Frontend
VITE_API_URL=

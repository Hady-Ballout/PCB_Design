# ── AI provider ──
# Set AI_PROVIDER=ollama for local dev, or an OpenAI-compatible provider
# (groq, openrouter, together, openai) for production.
AI_PROVIDER=groq
AI_API_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
AI_CONTEXT_DIAGNOSTICS=0

# ── Local Ollama (used when AI_PROVIDER=ollama) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_API_KEY=
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2400
OLLAMA_CONTEXT_DIAGNOSTICS=0

# ── Server ──
PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:5173

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string

# ── Database (Neon / Postgres) ──
DATABASE_URL=

# ── Email (Brevo) ──
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PCB Pilot

# ── Frontend ──
VITE_API_URL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_API_KEY=
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2400
OLLAMA_CONTEXT_DIAGNOSTICS=0

# OpenAI-compatible provider example (Z.ai / GLM)
AI_PROVIDER=
AI_API_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_TOKENS=12000
ZAI_THINKING_TYPE=disabled
ZAI_REASONING_EFFORT=none

# Server
PORT=8787
HOST=127.0.0.1
# Comma-separated allowlist; the first entry is the canonical frontend URL (used in emails).
CORS_ORIGIN=http://127.0.0.1:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Database (Neon / Postgres)
DATABASE_URL=

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PCB Pilot

# Frontend
VITE_API_URL=
